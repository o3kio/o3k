# Copy to ea-config.env and replace every `CHANGE_ME` value with the values
# reserved for one isolated qualification campaign. This file is ignored by git.
EA_RUN_ID=CHANGE_ME
EA_NETWORK=CHANGE_ME
EA_NETWORK_UUID=CHANGE_ME
EA_NETWORK_BRIDGE=CHANGE_ME
EA_NETWORK_CIDR=10.253.240.0/24
EA_NETWORK_GATEWAY=10.253.240.1
EA_DHCP_START=10.253.240.100
EA_DHCP_END=10.253.240.199
EA_POOL=CHANGE_ME
EA_POOL_UUID=CHANGE_ME
EA_IMAGE_ROOT=/var/lib/o3k-testlab
EA_POOL_ROOT=/var/lib/o3k-testlab/CHANGE_ME
EA_BASE_IMAGE=/var/lib/libvirt/images/noble-server-cloudimg-amd64.img
EA_BASE_SHA256=CHANGE_ME
EA_DOMAIN_PREFIX=CHANGE_ME
EA_HOSTS=3
