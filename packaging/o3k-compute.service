[Unit]
Description=O3K libvirt compute agent
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=o3k-compute
Group=o3k-compute
SupplementaryGroups=libvirt kvm o3k
EnvironmentFile=-/etc/o3k/o3k-compute.env
ExecStart=/usr/local/bin/o3k-compute
Restart=on-failure
NoNewPrivileges=true
# Group read/write (not world): the QEMU process (primary group kvm) must
# open the overlays, backing images, config-drive publications, and console
# sinks the agent creates under the kvm-group compute data directory. A
# 0077 umask produces 0600 files that the QEMU process cannot read, which
# fails domain start with "Cannot access storage file ... Permission
# denied". Secrets never land here: the agent's TLS keys live in
# /etc/o3k/tls with their own 0640 ownership.
UMask=0027
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/o3k/compute /var/log/o3k
# Ambient caps for the host-network + DHCP work, matching the testlab launch
# (scripts/bootstrap-disposable-testlab.sh): CAP_NET_ADMIN for TAP/bridge/
# gateway setup, and CAP_NET_BIND_SERVICE + CAP_NET_RAW so the spawned dnsmasq can bind
# UDP/67 and serve DHCP (issue-87 re-probe matrix, dnsmasq 2.90). Ambient so
# helper processes (ip, dnsmasq) retain them across exec; NoNewPrivileges does
# not restrict ambient capabilities.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
