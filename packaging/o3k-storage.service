[Unit]
Description=O3K restricted native storage executor
After=network-online.target o3kd.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/o3k/o3k-storage.env
# O3K_STORAGE_CONTROLLER_IDENTITY must be the exact URI SAN of the controller
# certificate; CA membership alone is not sufficient authorization.
ExecStart=/usr/local/bin/o3k-storage-bin
Restart=on-failure
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
ReadWritePaths=/var/lib/o3k/storage
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
