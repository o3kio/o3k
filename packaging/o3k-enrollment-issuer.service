[Unit]
Description=O3K Early Access enrollment certificate issuer connection
After=network.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/o3k-enrollment-issuer
StandardInput=socket
StandardOutput=socket
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/o3k/ea /run/o3k

