[Unit]
Description=O3K Early Access enrollment certificate issuer
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/o3k-enrollment-issuer
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/o3k/ea /run/o3k
Restart=on-failure

