[Unit]
Description=O3K Early Access enrollment issuer socket

[Socket]
ListenStream=/run/o3k/enrollment-issuer.sock
Accept=yes
SocketUser=o3k
SocketGroup=o3k
SocketMode=0600
# The o3k controller must traverse this runtime directory to connect. The
# socket itself remains restricted to the o3k owner at mode 0600.
DirectoryMode=0711

[Install]
WantedBy=sockets.target
