    "errors": {
      "content_type": "application/json",
      "envelope": {
        "required_top_level": "error",
        "required_fields": ["code", "title", "message"],
        "field_types": {"code": "integer", "title": "string", "message": "string"}
      },
      "status_meanings": {
        "400": "invalid request",
        "401": "missing or invalid authentication",
        "403": "authenticated but not authorized",
        "404": "resource absent or project boundary concealed",
        "405": "method not part of the baseline",
        "409": "conflict with current resource state",
        "413": "request or image payload too large",
        "406": "unsupported requested microversion"
      },
      "security": "Error messages contain no tokens, passwords, private keys, provider credentials, or unredacted provider payloads."
    }
  },
