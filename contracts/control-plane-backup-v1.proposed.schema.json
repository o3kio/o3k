{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://o3k.io/contracts/proposed/control-plane-backup-v1.schema.json",
  "title": "Proposed O3K PP.6 control-plane backup manifest v1",
  "$comment": "PROPOSED only. This is not an accepted or advertised contract until ADR-0189 and SPEC-0050 receive human architecture/security approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "backup_id",
    "created_at",
    "installation_id",
    "source",
    "store",
    "consistency",
    "state_inventory",
    "members",
    "encryption",
    "authentication",
    "excluded_state"
  ],
  "properties": {
    "format_version": {
      "const": "1"
    },
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "o3k_version",
        "source_sha",
        "release_artifact_sha256",
        "profile_id"
      ],
      "properties": {
        "o3k_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_sha": {
          "$ref": "#/$defs/gitCommitSha"
        },
        "release_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_id": {
          "type": "string",
          "enum": ["o3k-demo-v1", "o3k-small-edge-v1"]
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "server_version",
        "schema_version",
        "migrations"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["sqlite", "postgresql"]
        },
        "server_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schema_version": {
          "type": "integer",
          "minimum": 0
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "checksum"],
            "properties": {
              "version": { "type": "integer", "minimum": 0 },
              "checksum": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "extensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 },
          "uniqueItems": true
        }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "write_quiescence", "worker_quiescence", "in_flight_operations", "quiescence_generation", "snapshot_started_at", "snapshot_completed_at"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["sqlite_vacuum_into", "postgresql_native_dump"]
        },
        "write_quiescence": { "const": true },
        "worker_quiescence": { "const": true },
        "in_flight_operations": {
          "type": "string",
          "enum": ["none", "drained", "recorded_unknown"]
        },
        "quiescence_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "snapshot_started_at": { "type": "string", "format": "date-time" },
        "snapshot_completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "state_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "canonical_resources",
          "operations_and_reconciliation",
          "placement_allocations_and_provider_mappings",
          "topology_and_building_blocks",
          "iam_and_security_scope",
          "bootstrap_enrollment_and_revocation",
          "audit_and_governance",
          "o3k_owned_configuration",
          "release_and_install_metadata"
        ]
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size_bytes", "sha256", "media_type", "encrypted"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(database|config|release|identity|trust|metadata)/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
          },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": {
            "$ref": "#/$defs/sha256",
            "description": "SHA-256 digest of the encrypted member bytes"
          },
          "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "encrypted": { "const": true }
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "key_is_external"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1, "maxLength": 128 },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "key_is_external": { "const": true }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1, "maxLength": 128 },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "contentEncoding": "base64"
        }
      }
    },
    "excluded_state": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "tenant_vm_disks_and_guest_filesystems",
          "hypervisor_local_guest_runtime_state",
          "external_storage_payloads",
          "external_hosted_service_databases",
          "provider_local_caches"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "store": { "properties": { "backend": { "const": "sqlite" } } }
        },
        "required": ["store"]
      },
      "then": {
        "properties": {
          "consistency": {
            "properties": { "method": { "const": "sqlite_vacuum_into" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "store": { "properties": { "backend": { "const": "postgresql" } } }
        },
        "required": ["store"]
      },
      "then": {
        "properties": {
          "consistency": {
            "properties": { "method": { "const": "postgresql_native_dump" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "gitCommitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
